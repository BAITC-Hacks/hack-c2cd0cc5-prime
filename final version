  function search(params) {
    const query = params.get('q') || '';
    const inStock = ['1', 'true'].includes(params.get('inStock'));
    let rows = rank(query, params.get('category') || '', inStock).map(r => r.product);
    const sort = params.get('sort');
    if (['price_asc', 'price-asc', 'priceAsc'].includes(sort)) rows.sort((a, b) => (a.price == null ? Infinity : a.price) - (b.price == null ? Infinity : b.price));
    if (['price_desc', 'price-desc', 'priceDesc'].includes(sort)) rows.sort((a, b) => (b.price == null ? -Infinity : b.price) - (a.price == null ? -Infinity : a.price));
    if (['name', 'name_asc'].includes(sort)) rows.sort((a, b) => a.name.localeCompare(b.name, 'ru'));
    const page = Math.max(1, Math.trunc(Number(params.get('page')) || 1));
    const limit = Math.max(1, Math.min(48, Math.trunc(Number(params.get('limit')) || 24)));
    return { items: clone(rows.slice((page - 1) * limit, page * limit)), total: rows.length, page,
      pages: Math.ceil(rows.length / limit), mode: 'preview', preview: true,
      catalogComplete: !!window.EKT_BOOTSTRAP.complete, stockFilterComplete: false,
      message: inStock ? 'В предпросмотре показан положительный остаток только у карточек с сохранёнными подробными данными.' : PREVIEW_NOTE };
  }

  function getProduct(id) {
    const p = byId.get(String(id));
    if (!p) fail('товар не найден в сохранённом каталоге.', 404);
    return p;
  }

  function cart() {
    const items = [...cartItems.values()].map(e => ({ product: clone(getProduct(e.productId)), quantity: e.quantity }));
    return { items, count: items.reduce((sum, e) => sum + e.quantity, 0),
      total: items.reduce((sum, e) => sum + (e.product.price || 0) * e.quantity, 0),
      hasUnknownPrices: items.some(e => !realPrice(e.product)), url: '/cart', checkoutEnabled: false,
      mode: 'preview', preview: true, message: 'Корзина предпросмотра. Она не передаётся в EKT; оформление заказа недоступно.' };
  }

  function validateQuantity(value) {
    if (typeof value !== 'number' || !Number.isInteger(value) || value < 1 || value > 100000) fail('укажите целое количество от 1 до 100000.');
    return value;
  }

  function mutate(payload, method) {
    if (payload.confirm !== true) fail('для изменения корзины нужно явное подтверждение.', 409);
    const id = String(payload.productId || '');
    const product = getProduct(id);
    if (method === 'DELETE') { cartItems.delete(id); return cart(); }
    const quantity = validateQuantity(payload.quantity == null ? 1 : payload.quantity);
    const current = cartItems.get(id)?.quantity || 0;
    const wanted = method === 'POST' ? current + quantity : quantity;
    if (!knownStock(product)) fail('остаток этой позиции не сохранён. Добавление возможно после проверки через сервер EKT.', 409);
    if (wanted > product.stock) fail('в снимке доступно ' + product.stock + ' ' + product.unit + '; с учётом корзины запрошено ' + wanted + '.', 409);
    if (!realPrice(product)) fail('цена не указана. Уточните её у менеджера EKT.', 409);
    const minimum = Number(product.specs['Минимальная кратность'] || product.specs.KRATNOST_MIN || product.minimumQuantity || 1);
    if (Number.isFinite(minimum) && minimum > 1 && (wanted < minimum || Math.abs(wanted / minimum - Math.round(wanted / minimum)) > 1e-8)) fail('для этой позиции в каталоге указана кратность ' + minimum + ' ' + product.unit + '.', 409);
    cartItems.set(id, { productId: id, quantity: wanted });
    return cart();
  }

  function response(text, displayed = [], extra = {}) {
    const result = { text: PREVIEW_NOTE + '\n\n' + text, products: clone(displayed), mode: 'preview', preview: true, ...extra };
    if (displayed.length) lastProducts = displayed.map(p => p.id);
    history.push({ role: 'assistant', content: result.text });
    if (history.length > 40) history.splice(0, history.length - 40);
    return result;
  }

  function facts(p) {
    const availability = !knownStock(p) ? 'остаток не сохранён' : p.stock > 0 ? 'в снимке: ' + p.stock + ' ' + p.unit : 'в снимке остаток нулевой';
    return p.name + '\nАртикул ' + p.sku + ' · ' + money(p.price) + ' · ' + availability + '.';
  }

  function policy(key) {
    const root = window.EKT_BOOTSTRAP.policies || {};
    const entry = root[key] || root.policies?.[key];
    if (typeof entry === 'string') return entry;
    if (entry && (entry.text || entry.summary)) return (entry.text || entry.summary) + (entry.source ? '\nИсточник: ' + entry.source : '');
    return { delivery: 'Условия доставки зависят от адреса, веса и объёма. Подтвердить их можно у менеджера EKT: https://ekt.kz/checkout-delivery/',
      payment: 'Способы оплаты нужно подтвердить на официальной странице EKT: https://ekt.kz/checkout-delivery/',
      minimumOrder: 'Общая минимальная сумма заказа в доступных данных не подтверждена. Минимальная партия зависит от товара; если она не указана в карточке, уточните у менеджера.' }[key];
  }

  function confirm(payload) {
    if (payload.confirm !== true) fail('подтвердите добавление товара.', 409);
    const proposal = proposals.get(String(payload.token || ''));
    if (!proposal) fail('предложение не найдено. Попросите Хелпи подготовить его снова.', 404);
    if (proposal.used) return response('Эта позиция уже добавлена по вашему подтверждению.', [], { cart: cart(), actions: [{ label: 'Перейти в корзину', url: '/cart' }] });
    if (Date.now() - proposal.created > 10 * 60 * 1000) fail('предложение устарело. Уточните товар и количество ещё раз.', 409);
    const updated = mutate({ productId: proposal.productId, quantity: proposal.quantity, confirm: true }, 'POST');
    proposal.used = true;
    if (pendingToken === proposal.token) pendingToken = null;
    return response('Готово, добавил ' + proposal.quantity + ' ' + getProduct(proposal.productId).unit + ' в локальную корзину. Заказ в EKT не создаётся; перед покупкой нужно проверить актуальные цену и остаток.', [], { cart: updated, actions: [{ label: 'Перейти в корзину', url: '/cart' }] });
  }

  function alternatives(main) {
    const mainWords = queryTerms(main.name);
    return index.filter(r => r.p.id !== main.id && r.family === family(main) && knownStock(r.p) && r.p.stock > 0)
      .map(r => ({ p: r.p, score: mainWords.reduce((s, w) => s + (termMatches(r, w) ? 1 : 0), 0) }))
      .filter(r => r.score > 1).sort((a, b) => b.score - a.score).slice(0, 3).map(r => r.p);
  }

  function chat(payload) {
    const message = String(payload.message || '').trim().slice(0, 4000);
    if (!message) fail('напишите название товара, артикул или вопрос.');
    const lower = normalize(message);
    history.push({ role: 'user', content: message });
    if (/^(?:да[,.! ]*)?(?:добавь|добавляй|подтверждаю|положи)(?:[,! .]*|\s+в корзину[.! ]*)$/.test(lower) && pendingToken) return confirm({ token: pendingToken, confirm: true });
    if (/^(?:нет|не надо|отмена|отмени|не добавляй)[.! ]*$/.test(lower)) {
      if (pendingToken) proposals.delete(pendingToken);
      pendingToken = null;
      return response('Хорошо, предложение отменил. Корзина не изменилась.');
    }
    if (/номер.*карт|cvv|cvc|парол/.test(lower)) return response('Платёжные данные и пароли для консультации не нужны. Оплачивайте покупку только через официальный сервис EKT.');
    if (/^((привет|здравствуйте|добрый день|добрый вечер|салем|сәлем|hello|hi)[!. ]*)$/.test(lower)) return response('Привет! Я Хелпи. В этом режиме я ищу по локальному каталогу без подключения языковой модели: помогу найти товар по названию или артикулу, посмотреть сохранённые характеристики и собрать пример корзины. Что ищем?');
    if (/спасибо|благодар/.test(lower) && lower.length < 45) return response('Пожалуйста! Если нужно, ещё сравним варианты или посмотрим характеристики.');
    const delivery = /достав|самовывоз|привез/.test(lower);
    const payment = /оплат|платеж|картой|счет|наличн/.test(lower);
    if (delivery || payment) return response([delivery ? policy('delivery') : '', payment ? policy('payment') : ''].filter(Boolean).join('\n\n'), [], { actions: [{ label: 'Условия на ekt.kz', url: 'https://ekt.kz/checkout-delivery/' }] });
    if (/менеджер|оператор|позвон|контакты|связаться/.test(lower)) return response('Связаться с EKT можно по телефону +7 (727) 346-88-88 или +7 (778) 046-88-88. Алматы: ул. Кудерина, 47Б. Переписку я автоматически не отправляю.', [], { actions: [{ label: 'Контакты EKT', url: 'https://ekt.kz/about/contacts/' }] });
    if (/вложени|загруз.*файл|распозна|фотограф|\.xlsx|\.pdf|\.docx/.test(lower)) return response('Для разбора файлов нужен запущенный сервер проекта. В HTML-предпросмотре я не читаю вложения. Напишите название или артикул текстом — по нему найду товар.');
    if (/корзин/.test(lower) && /покажи|состав|что|открой/.test(lower) && !/добав/.test(lower)) return response('Вот ваша локальная корзина предпросмотра. Для покупки товары нужно подтвердить на стороне EKT.', [], { cart: cart(), actions: [{ label: 'Перейти в корзину', url: '/cart' }] });
    if (/оформ|оплатить заказ/.test(lower)) return response('Здесь можно собрать только локальную корзину. Оформление и оплата доступны на официальном сайте после проверки актуальных данных.', [], { cart: cart(), actions: [{ label: 'Открыть ekt.kz', url: 'https://ekt.kz/' }] });
    const minimumQuestion = /минимальн.*(?:парт|заказ|сумм|колич)|кратност/.test(lower);
    const buy = /добав|возьму|беру|полож|закаж|хочу купить/.test(lower);
    const analog = /аналог|замен|похож|подешевле/.test(lower);
    const compare = /сравн|отлич|разниц/.test(lower);
    const detailsQuestion = /характер|параметр|сертифик|расскажи|подроб|склад|остат/.test(lower);
    const unitQuantity = lower.match(/(\d+(?:\.\d+)?)\s*(?:шт|штук|метр|м(?=\s|$))/);
    const leadingQuantity = lower.match(/(?:добав\S*|возьму|беру|полож\S*)\s+(\d+(?:\.\d+)?)(?=\s|$)/);
    const quantityText = unitQuantity?.[1] || (leadingQuantity && !byId.has(leadingQuantity[1]) ? leadingQuantity[1] : null);
    // Remove the original leading quantity before unit removal, so a following product ID stays intact.
    const stripped = message.replace(/((?:добав\S*|возьму|беру|полож\S*)\s+)(\d+(?:[.,]\d+)?)(?=\s|$)/gi,
      (whole, verb, value) => byId.has(value) ? whole : verb)
      .replace(/\d+(?:[.,]\d+)?\s*(?:шт\.?|штук(?:и)?|метр(?:ов|а)?|м(?=\s|$))/gi, '');
    let ranked = rank(stripped);
    let selected = ranked.slice(0, 4).map(r => r.product);
    const contextual = /(?:^|\s)(?:его|ее|этот|эту|этого|первый|первого|второй|второго|третий|третьего|их|них)(?=\s|$)/.test(lower);
    const genericFollowup = (analog || compare || detailsQuestion || /налич/.test(lower)) && queryTerms(stripped).every(w => /^(?:характер|параметр|сертифик|налич|остат|склад|подроб|аналог|сравн|отлич|разниц|где|каком|можешь|рассказать|нем|она|он)/.test(w));
    if (lastProducts.length && (contextual || genericFollowup)) {
      const position = /втор/.test(lower) ? 1 : /трет/.test(lower) ? 2 : 0;
      selected = (compare ? lastProducts.slice(0, 3) : [lastProducts[Math.min(position, lastProducts.length - 1)]]).map(getProduct);
      ranked = selected.map(product => ({ product, exact: true, score: 10000 }));
    }
    if (minimumQuestion) {
      const candidate = ranked.find(r => r.exact)?.product;
      if (candidate) {
        const minimum = candidate.specs['Минимальная кратность'] || candidate.specs.KRATNOST_MIN;
        return response(minimum ? candidate.name + '\nВ карточке указана минимальная кратность ' + minimum + ' ' + candidate.unit + '. Актуальные условия отпуска нужно подтвердить при покупке.' : candidate.name + '\nМинимальная партия в сохранённой карточке не указана. Уточните её у менеджера EKT.', [candidate]);
      }
      return response(policy('minimumOrder'));
    }
    if (!queryTerms(stripped).length && !contextual && !(genericFollowup && lastProducts.length)) return response('Конечно, помогу. Что ищем: кабель, автомат, лампу или розетку? Можно написать артикул или параметры — например, «ВВГ 3×2,5» или «автомат 16А».');
    if (!selected.length) return response('По этому запросу подходящая позиция пока не нашлась. Напишите артикул или уточните тип и параметры товара. Отсутствие результата поиска не подтверждает отсутствие товара у EKT.');
    const main = selected[0];
    if (buy) {
      if ((selected.length > 1 && !ranked[0]?.exact && !contextual) || ranked.filter(r => r.exact).length > 1) return response('Нашлось несколько вариантов. Какой добавить? Напишите артикул или выберите «первый» / «второй» и укажите количество.', selected);
      const quantity = validateQuantity(quantityText ? Number(quantityText) : 1);
      const wanted = quantity + (cartItems.get(main.id)?.quantity || 0);
      if (!knownStock(main)) return response(facts(main) + '\n\nОстаток этой позиции в снимке не сохранён. Чтобы подготовить добавление, нужна проверка через сервер EKT.', [main]);
      if (wanted > main.stock) return response(facts(main) + '\n\nДля выбранного количества с учётом корзины остатка в снимке недостаточно. Могу показать похожие позиции.', [main, ...alternatives(main)]);
      if (!realPrice(main)) return response(facts(main) + '\n\nБез подтверждённой цены эту позицию пока не добавляю.', [main]);
      const token = 'preview-' + Date.now().toString(36) + '-' + (++sequence);
      const proposal = { productId: main.id, quantity, token };
      proposals.set(token, { ...proposal, created: Date.now(), used: false });
      pendingToken = token;
      return response('Добавить ' + quantity + ' ' + main.unit + ' «' + main.name + '» в локальную корзину? Сумма по снимку — ' + money(main.price * quantity) + '.\n\nНажмите кнопку подтверждения или напишите «да, добавь». Заказ в EKT при этом не создаётся.', [main], { proposal });
    }
    if (analog || (main.stock === 0 && !detailsQuestion)) {
      const options = alternatives(main);
      return response(facts(main) + '\n\n' + (options.length ? 'Нашёл кандидатов с положительным остатком в снимке: у них сходные названия и назначение. Это варианты для сравнения, совместимость по току, полюсам, сечению и монтажу нужно подтвердить отдельно.' : 'Подходящий вариант с сохранённым положительным остатком не найден. Уточните ключевые параметры — менеджер сможет проверить актуальные аналоги.'), [main, ...options]);
    }
    if (compare) return response('Сравним сохранённые данные:\n\n' + selected.slice(0, 3).map(p => facts(p) + '\n' + Object.entries(p.specs).filter(([k]) => !/^[A-Z0-9_]+$/.test(k)).slice(0, 5).map(([k, v]) => k + ': ' + v).join('; ')).join('\n\n') + '\n\nДля окончательного выбора нужно проверить параметры вашей сети и оборудования.', selected.slice(0, 3));
    if (detailsQuestion || ranked[0]?.exact || selected.length === 1) {
      let text = facts(main);
      if (main.description) text += '\n\n' + main.description.slice(0, 1600);
      const readable = Object.entries(main.specs).filter(([k]) => !/^(?:CML|BRAND_PRIORITY|BLOG|RECOMMEND|IMYAKARTINKI|insta|SLIDER|NOVINKA|SPETSPRED)/.test(k));
      if (readable.length) text += '\n\nДанные карточки:\n' + readable.slice(0, 9).map(([k, v]) => '• ' + k + ': ' + v).join('\n');
      const warehouses = main.warehouses.filter(w => typeof w.stock === 'number' && w.stock > 0);
      if (warehouses.length) text += '\n\nОстатки в снимке по складам: ' + warehouses.map(w => w.name + ' — ' + w.stock + ' ' + main.unit).join('; ') + '.';
      if (/сертифик/.test(lower)) text += '\n\n' + (main.certificates.length ? main.certificates.map(c => c.name + ': ' + c.url).join('\n') : 'Ссылка на сертификат в этой карточке не сохранена. Документ можно запросить у менеджера EKT.');
      return response(text + '\n\nМогу сравнить с другой позицией или подготовить добавление в локальную корзину.', [main]);
    }
    return response('Вот подходящие позиции из каталога. У карточек без сохранённого остатка наличие пока неизвестно.\n\n' + selected.slice(0, 3).map(facts).join('\n\n') + '\n\nКакой вариант посмотрим подробнее?', selected);
  }

  window.PreviewAPI = async function PreviewAPI(path, method = 'GET', body = null) {
    initialize();
    const url = new URL(path, 'https://preview.local');
    const route = url.pathname;
    method = String(method).toUpperCase();
    const payload = body || {};
    if (method === 'GET' && route === '/api/status') return status();
    if (method === 'GET' && route === '/api/products') return search(url.searchParams);
    if (method === 'GET' && route.startsWith('/api/products/')) return clone(getProduct(decodeURIComponent(route.slice('/api/products/'.length))));
    if (method === 'GET' && route === '/api/cart') return cart();
    if (method === 'GET' && route === '/api/history') return { messages: clone(history), mode: 'preview' };
    if (['POST', 'PATCH', 'DELETE'].includes(method) && route === '/api/cart') return mutate(payload, method);
    if (method === 'POST' && route === '/api/chat') return chat(payload);
    if (method === 'POST' && route === '/api/chat/confirm') return confirm(payload);
    if (route === '/api/attachments') return response('Для разбора Excel, Word, PDF и изображений нужен запущенный сервер проекта. В HTML-предпросмотре вложение не прочитано. Напишите артикулы или название товара текстом.');
    fail('этот раздел требует запущенного сервера проекта.', 404);
  };
})();


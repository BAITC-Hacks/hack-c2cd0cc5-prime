const state={preview:true,status:{},products:new Map(),query:'',page:1,pages:1,sort:'default',tab:'all',favorites:new Set(Array.isArray(saved)?saved.map(String):[]),cart:{items:[],total:0,count:0},city:'Алматы',busy:false,catalogRequest:0,chatBusy:false,chatHistory:[],activeProduct:null};
function toast(text,error=false){const e=$('#toast');e.textContent=text;e.classList.toggle('error',error);e.hidden=false;clearTimeout(toast.timer);toast.timer=setTimeout(()=>e.hidden=true,4500)}
async function api(path,method='GET',body=null){if(state.preview){if(!window.PreviewAPI)throw new Error('Для работы каталога запустите сервер проекта.');return window.PreviewAPI(path,method,body)}const opts={method,credentials:'same-origin',headers:{Accept:'application/json'},signal:AbortSignal.timeout(path.includes('/chat')||path.includes('/attachments')?90000:60000)};if(body){opts.headers['Content-Type']='application/json';opts.body=JSON.stringify(body)}let response;try{response=await fetch(path,opts)}catch(e){throw new Error(e.name==='TimeoutError'?'Запрос занял больше времени. Попробуйте ещё раз.':'Нет связи с сервером. Проверьте подключение и повторите.')}let data;try{data=await response.json()}catch{throw new Error('Сервер вернул непонятный ответ. Обновите страницу.')}if(!response.ok)throw new Error(data.error||'Не удалось выполнить запрос.');return data}
function track(products=[]){products.forEach(p=>state.products.set(String(p.id),p))}
function formattedDate(s){if(!s)return 'дата не указана';try{return new Date(s).toLocaleString('ru-RU',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'})}catch{return s}}
function statusText(){const s=state.status;const n=integer(s.catalogCount||window.EKT_BOOTSTRAP?.items?.length||0);if(state.preview)return `Предпросмотр · ${n} товаров · данные на ${formattedDate(s.syncedAt||window.EKT_BOOTSTRAP?.fetchedAt)}. Актуальное наличие проверяется на сервере.`;if(s.stale&&s.message)return s.message+' · Каталог: '+n+' товаров';if(s.mode==='live')return `${s.catalogComplete?'Полный каталог':'Каталог обновляется'} · ${n} товаров · остатки проверяются в API EKT${s.syncing?' · идёт обновление':''}`;return `Сохранённый каталог · ${n} товаров · ${formattedDate(s.syncedAt)}. Для актуальных цен и остатков требуется подключение к API.`}
function updateStatus(){const s=state.status;$('#status-text').textContent=statusText();$('#data-status').classList.toggle('offline',state.preview||s.mode!=='live');$('#chat-status').textContent=state.preview?'Каталог в предпросмотре':s.llmEnabled?'Хелпи · каталог и ИИ':'Помощник по каталогу';$('#chat-disclaimer').textContent=state.preview?'Предпросмотр · корзина учебная, заказ не отправляется':'Добавляю в корзину только с вашего согласия'}
function stockText(p){if(p.stock==null)return {text:'Наличие уточняется',cls:'unknown'};if(p.stock<=0)return {text:p.mode==='offline'||state.preview?'Нет в сохранённом остатке':'Нет в наличии',cls:'empty'};const offline=p.mode==='offline'||state.preview;return {text:`${offline?'В снимке':'В наличии'}: ${integer(p.stock)} ${p.unit||'шт'}`,cls:offline?'unknown':''}}
function productCard(p){const st=stockText(p);const im=imageURL(p);return `<article class="product-card" data-product="${esc(p.id)}"><button class="product-favorite ${state.favorites.has(p.id)?'selected':''}" data-favorite="${esc(p.id)}" aria-label="${state.favorites.has(p.id)?'Убрать из избранного':'В избранное'}" aria-pressed="${state.favorites.has(p.id)}">${icon('heart')}</button>${p.brand?`<span class="product-badge">${esc(p.brand)}</span>`:''}<button class="product-image-button" data-detail="${esc(p.id)}" aria-label="Открыть ${esc(p.name)}">${im?`<img src="${esc(im)}" alt="${esc(p.name)}" loading="lazy" data-fallback>`:`<span class="product-image-placeholder">${icon('bolt')}</span>`}</button><p class="product-sku">Арт. ${esc(p.sku)}</p><button class="product-name" data-detail="${esc(p.id)}">${esc(p.name)}</button><div class="product-stock ${st.cls}"><span class="stock-dot"></span>${esc(st.text)}</div><div class="product-bottom"><div class="product-price${p.price==null||p.price<=0?' unknown-price':''}">${money(p.price)}${p.price?`<span class="product-unit">/ ${esc(p.unit||'шт')}</span>`:''}</div><button class="product-cart" data-quick-add="${esc(p.id)}" aria-label="Выбрать количество ${esc(p.name)}">${icon('cart')}</button></div></article>`}
function imageFallbacks(scope=document){scope.querySelectorAll('img[data-fallback]').forEach(img=>{img.addEventListener('error',()=>{img.outerHTML=`<span class="product-image-placeholder">${icon('bolt')}</span>`},{once:true})})}
function emptyCatalog(){return `<div class="empty-state"><h3>${state.tab==='favorites'?'Здесь будет ваш выбор':'Давайте поищем иначе'}</h3><p>${state.tab==='favorites'?'Нажмите на сердечко у товара — он сохранится здесь.':state.tab==='stock'?'Подтверждённые остатки по этому запросу пока не найдены. Попробуйте уточнить артикул у Хелпи.':'По этому запросу товаров не найдено. Попробуйте название короче или напишите Хелпи, для какой задачи ищете товар.'}</p><button class="button secondary" data-chat>Спросить Хелпи ${icon('spark')}</button></div>`}
async function loadProducts(append=false){const request=++state.catalogRequest;state.busy=true;$('#load-more').disabled=true;if(!append)$('#product-grid').innerHTML='<div class="skeleton-card"></div>'.repeat(4);$('#catalog-title').textContent=state.tab==='favorites'?'Избранное':state.query?`Результаты поиска`:'Всё для вашего проекта';$('#query-bar').hidden=!state.query;$('#query-text').textContent=`По запросу «${state.query}»`;
try{let result;if(state.tab==='favorites'){let items=await Promise.all([...state.favorites].map(async id=>{try{return state.products.get(id)||await api('/api/products/'+encodeURIComponent(id))}catch{return null}}));items=items.filter(Boolean).filter(p=>!state.query||p.name.toLowerCase().includes(state.query.toLowerCase())||p.sku.includes(state.query));result={items,total:items.length,page:1,pages:1}}else{const query=new URLSearchParams({q:state.query,sort:state.sort,page:String(state.page),limit:'8',inStock:state.tab==='stock'?'1':'0'});result=await api('/api/products?'+query)}if(request!==state.catalogRequest)return;track(result.items);state.pages=result.pages||1;$('#catalog-total').textContent=`${integer(result.total||0)} товаров`;const markup=result.items.map(productCard).join('')||emptyCatalog();if(append)$('#product-grid').insertAdjacentHTML('beforeend',markup);else $('#product-grid').innerHTML=markup;imageFallbacks($('#product-grid'));$('#load-more').hidden=state.page>=state.pages||state.tab==='favorites';if(state.tab==='stock'&&result.stockFilterComplete===false)$('#status-text').textContent=statusText()+' Показаны проверенные позиции; наличие всего каталога ещё уточняется.'}catch(e){if(request!==state.catalogRequest)return;$('#product-grid').innerHTML=`<div class="empty-state"><h3>Не удалось загрузить товары</h3><p>${esc(e.message)}</p><button class="button secondary" data-retry>Попробовать снова</button></div>`;$('#catalog-total').textContent=''}finally{if(request===state.catalogRequest){state.busy=false;$('#load-more').disabled=false}}}
function goCatalog(q=null){if(q!==null){state.query=q;$('#search').value=q;state.tab='all';setTabs();state.page=1;loadProducts()}$('#catalog').scrollIntoView({behavior:'smooth'})}
function setTabs(){$('#all-tab').classList.toggle('active',state.tab==='all');$('#stock-tab').classList.toggle('active',state.tab==='stock');$('#favorite-tab').classList.toggle('active',state.tab==='favorites')}
function updateFavorites(){try{localStorage.setItem('ekt-favorites',JSON.stringify([...state.favorites]))}catch{}$('#favorite-count').textContent=state.favorites.size;$('#favorite-count').hidden=!state.favorites.size;$('#favorite-tab-count').textContent=state.favorites.size;$$('[data-favorite]').forEach(b=>{const yes=state.favorites.has(b.dataset.favorite);b.classList.toggle('selected',yes);b.setAttribute('aria-pressed',String(yes));b.setAttribute('aria-label',yes?'Убрать из избранного':'В избранное')})}
function toggleFavorite(id){state.favorites.has(id)?state.favorites.delete(id):state.favorites.add(id);updateFavorites();if(state.tab==='favorites')loadProducts()}
function showDialog(id){const d=$(id);if(!d.open)d.showModal()}
function detailMarkup(p){const st=stockText(p),im=imageURL(p);const warehouses=(p.warehouses||[]).slice().sort((a,b)=>Number(b.name.includes(state.city))-Number(a.name.includes(state.city)));const snapshot=state.preview||p.mode==='offline';return `<div class="product-detail-top"><div class="detail-image">${im?`<img src="${esc(im)}" alt="${esc(p.name)}" data-fallback>`:icon('bolt')}</div><div class="detail-info"><span class="section-kicker">${esc(p.category)}</span><h2>${esc(p.name)}</h2><p class="product-sku">Артикул: ${esc(p.sku)} · ID: ${esc(p.id)}</p><div class="product-stock ${st.cls}"><span class="stock-dot"></span>${esc(st.text)}</div><div class="detail-price">${money(p.price)} <span>${p.price?'/ '+esc(p.unit||'шт'):''}</span></div><div class="detail-add-row"><div class="quantity-stepper"><button data-step="-1" aria-label="Уменьшить количество">${icon('minus')}</button><input type="number" id="detail-quantity" value="${p.minimumQuantity||1}" min="${p.minimumQuantity||1}" step="${p.minimumQuantity||1}" max="${p.stock||100000}" aria-label="Количество"><button data-step="1" aria-label="Увеличить количество">${icon('plus')}</button></div><button class="button primary" id="detail-add" ${p.stock===0||!p.price?'disabled':''}>${icon('cart')}Добавить в корзину</button></div><button class="detail-ask" data-ask-product="${esc(p.id)}">${icon('spark')}Спросить Хелпи об этом товаре</button>${warehouses.length?`<div class="warehouse-list"><h3>${snapshot?'Остатки на дату снимка':'Наличие по складам'}</h3>${warehouses.map(w=>`<div><span>${esc(w.name)}</span><strong>${w.stock==null?'Уточняется':integer(w.stock)+' '+esc(p.unit||'шт')}</strong></div>`).join('')}</div>`:''}</div></div><div class="detail-extra">${snapshot?'<p>Это сохранённая карточка. Цена и остатки могут измениться; перед покупкой нужна актуальная проверка.</p>':''}${p.description?`<h3>О товаре</h3><p>${esc(p.description)}</p>`:''}<h3>Характеристики</h3>${Object.keys(p.specs||{}).length?`<table class="specs-table"><tbody>${Object.entries(p.specs).map(([k,v])=>`<tr><th>${esc(k)}</th><td>${esc(v)}</td></tr>`).join('')}</tbody></table>`:'<p>В полученных данных характеристики не указаны. Хелпи поможет уточнить нужные параметры.</p>'}<h3>Документы и сертификаты</h3>${p.certificates?.length?p.certificates.filter(c=>safeURL(c.url)).map(c=>`<p><a href="${esc(safeURL(c.url))}" target="_blank" rel="noopener">${esc(c.name||'Сертификат')} ↗</a></p>`).join(''):'<p>В карточке API сертификат не приложен. Его можно запросить у менеджера Электрокомплект.</p>'}${safeURL(p.url)?`<p><a href="${esc(safeURL(p.url))}" target="_blank" rel="noopener">Открыть товар на ekt.kz ↗</a></p>`:''}</div>`}
async function openDetail(id){$('#product-detail').innerHTML='<div style="padding:60px;text-align:center">Проверяем карточку товара…</div>';showDialog('#product-dialog');try{const p=await api('/api/products/'+encodeURIComponent(id));track([p]);state.activeProduct=p;$('#product-detail').innerHTML=detailMarkup(p);imageFallbacks($('#product-detail'))}catch(e){$('#product-detail').innerHTML=`<div style="padding:45px"><h2>Не удалось открыть товар</h2><p>${esc(e.message)}</p></div>`}}
function updateCart(cart){if(cart)state.cart=cart;$('#cart-count').textContent=integer(state.cart.count||0);$('#cart-modal-count').textContent=state.cart.items?.length||0;if($('#cart-dialog').open)renderCart()}
function renderCart(){const c=state.cart;$('#cart-modal-count').textContent=c.items.length;if(!c.items.length){$('#cart-items').innerHTML=`<div class="cart-empty">${icon('cart')}<h3>Начнём ваш проект?</h3><p>Найдите нужные товары в каталоге<br>или поручите подбор Хелпи.</p><button class="button primary" data-cart-catalog>Перейти в каталог ${icon('arrow')}</button></div>`;$('#cart-summary').innerHTML='';return}$('#cart-items').innerHTML=c.items.map(({product:p,quantity:q})=>`<article class="cart-item">${imageURL(p)?`<img src="${esc(imageURL(p))}" alt="${esc(p.name)}" data-fallback>`:''}<div class="cart-item-info"><h3>${esc(p.name)}</h3><p class="product-sku">Арт. ${esc(p.sku)}</p><div class="cart-item-actions"><div class="quantity-stepper"><button data-cart-qty="${esc(p.id)}" data-qty="${q-(p.minimumQuantity||1)}" aria-label="Уменьшить количество">${icon('minus')}</button><input value="${q}" aria-label="Количество ${esc(p.name)}" readonly><button data-cart-qty="${esc(p.id)}" data-qty="${q+(p.minimumQuantity||1)}" aria-label="Увеличить количество">${icon('plus')}</button></div><strong>${money(p.price==null?null:p.price*q)}</strong></div><button class="cart-remove" data-remove="${esc(p.id)}">Удалить</button></div></article>`).join('');$('#cart-summary').innerHTML=`<div class="cart-total-line"><span>Итого${c.hasUnknownPrices?' (известные цены)':''}</span><strong>${money(c.total)}</strong></div><div class="cart-note">${state.preview?'В предпросмотре корзина работает с сохранёнными ценами и остатками. Заказ не отправляется.':'Это корзина нового магазина. Состав заказа можно скачать; отправка в систему заказов EKT ещё не подключена.'}</div><button class="button primary cart-main-button" id="download-cart">${icon('file')}Скачать список заказа</button><button class="button secondary cart-main-button" data-cart-chat>${icon('spark')}Обсудить заказ с Хелпи</button><a class="cart-link" href="https://ekt.kz/about/contacts/" target="_blank" rel="noopener">Связаться с Электрокомплект ↗</a>`;imageFallbacks($('#cart-items'))}
async function openCart(){showDialog('#cart-dialog');$('#cart-items').innerHTML='<p style="padding:30px 0;color:#8097a6">Загружаем корзину…</p>';try{updateCart(await api('/api/cart'))}catch(e){toast(e.message,true);renderCart()}}
async function addCurrent(){const p=state.activeProduct,q=Number($('#detail-quantity').value);if(!Number.isInteger(q)||q<1)return toast('Укажите целое положительное количество.',true);const b=$('#detail-add');b.disabled=true;b.textContent='Проверяем наличие…';try{updateCart(await api('/api/cart','POST',{productId:p.id,quantity:q,confirm:true}));$('#product-dialog').close();toast(state.preview?'Добавлено в корзину предпросмотра':'Товар добавлен в корзину')}catch(e){toast(e.message,true)}finally{if($('#detail-add')){$('#detail-add').disabled=false;$('#detail-add').innerHTML=icon('cart')+'Добавить в корзину'}}}
function openChat(message){$('#chat-panel').hidden=false;$('.helpy-launcher-wrap').classList.add('hidden');if(!$('#chat-messages').children.length)chatWelcome();if(message)sendChat(message);else setTimeout(()=>$('#chat-input').focus(),100)}
function closeChat(){$('#chat-panel').hidden=true;$('.helpy-launcher-wrap').classList.remove('hidden');$('#chat-launcher').focus()}
function chatWelcome(){$('#chat-messages').innerHTML=`<div class="chat-welcome"><span class="welcome-tag">ПРИЯТНО ПОЗНАКОМИТЬСЯ</span><h3>Я Хелпи. Давайте<br>найдём ваше решение.</h3><p>Расскажите, что ищете, — название, артикул или просто задачу. Разберёмся вместе.</p><button class="welcome-task" data-prompt="Нужен автомат 16А">${icon('bolt')}Подобрать автомат 16А<span>→</span></button><button class="welcome-task" data-prompt="Покажи кабель ВВГ 3х2.5">${icon('search')}Найти кабель ВВГ 3×2,5<span>→</span></button><button class="welcome-task" data-prompt="Какие условия доставки и оплаты?">${icon('truck')}Узнать о доставке и оплате<span>→</span></button></div>`;if(state.preview)addMessage('bot','Сейчас открыт предпросмотр: я ищу по сохранённому каталогу. Остатки и цены относятся к дате снимка, корзина учебная. Для актуальной проверки запустите сервер проекта.')}
function addMessage(role,text){const e=document.createElement('div');e.className='message '+role;e.textContent=text;$('#chat-messages').append(e);scrollChat();return e}
function scrollChat(){requestAnimationFrame(()=>{const e=$('#chat-messages');e.scrollTop=e.scrollHeight})}
function chatProduct(p){return `<div class="chat-product">${imageURL(p)?`<img src="${esc(imageURL(p))}" alt="${esc(p.name)}" data-fallback>`:''}<div><strong>${esc(p.name)}</strong><span>Арт. ${esc(p.sku)} · ${esc(stockText(p).text)}</span><span class="chat-product-price">${money(p.price)}</span><div class="chat-product-actions"><button data-detail="${esc(p.id)}">Подробнее</button><button data-propose="${esc(p.id)}">Выбрать</button></div></div></div>`}
function renderReply(reply){track(reply.products);const e=addMessage('bot',reply.text||'Вот что удалось найти.');if(reply.products?.length)e.insertAdjacentHTML('beforeend',reply.products.slice(0,5).map(chatProduct).join(''));if(reply.proposal){const prop=reply.proposal;const p=state.products.get(String(prop.productId));const box=document.createElement('div');box.className='proposal';box.innerHTML=`<strong>Добавить ${integer(prop.quantity)} ${esc(p?.unit||'шт')} в корзину?</strong><p>${p?esc(p.name):'Выбранный товар'}${p?.price?'<br>Сумма: '+money(p.price*prop.quantity):''}<br>Пока ничего не добавлено.</p><button class="button primary" data-confirm="${esc(prop.token)}">Да, добавь ${icon('check')}</button>`;e.append(box)}if(reply.cart){updateCart(reply.cart);e.insertAdjacentHTML('beforeend','<button class="button secondary" data-open-cart style="margin-top:10px">Перейти в корзину '+icon('arrow')+'</button>')}if(reply.actions){for(const a of reply.actions){if(a.url==='/cart'&&!reply.cart)e.insertAdjacentHTML('beforeend','<button class="button secondary" data-open-cart style="margin-top:10px">Перейти в корзину '+icon('arrow')+'</button>');else if(safeURL(a.url)&&!a.url.startsWith('/'))e.insertAdjacentHTML('beforeend',`<p><a href="${esc(safeURL(a.url))}" target="_blank" rel="noopener">${esc(a.label||'Подробнее')} ↗</a></p>`)}}imageFallbacks(e);scrollChat()}
async function sendChat(text){text=(text??$('#chat-input').value).trim();if(!text||state.chatBusy)return;$('#chat-input').value='';$('#chat-input').style.height='34px';state.chatBusy=true;$('#chat-send').disabled=true;$('#attachment').disabled=true;addMessage('user',text);state.chatHistory.push({role:'user',content:text});const typing=addMessage('bot','Хелпи проверяет каталог…');typing.classList.add('typing');try{const r=await api('/api/chat','POST',{message:text});typing.remove();renderReply(r);state.chatHistory.push({role:'assistant',content:r.text})}catch(e){typing.remove();addMessage('bot',e.message+' Проверьте корзину перед повторным подтверждением.')}finally{state.chatBusy=false;$('#chat-send').disabled=false;$('#attachment').disabled=false;scrollChat()}}
async function confirmProposal(btn){if(state.chatBusy)return;state.chatBusy=true;btn.disabled=true;btn.textContent='Проверяем остаток…';try{const r=await api('/api/chat/confirm','POST',{token:btn.dataset.confirm,confirm:true});btn.textContent='Добавлено ✓';renderReply(r)}catch(e){btn.disabled=false;btn.textContent='Повторить подтверждение';addMessage('bot',e.message)}finally{state.chatBusy=false}}
async function upload(file){if(!file)return;if(state.chatBusy)return toast('Дождитесь ответа Хелпи.');openChat();if(file.size>8*1024*1024)return addMessage('bot','Файл больше 8 МБ. Разделите его на части или отправьте файл меньшего размера.');state.chatBusy=true;$('#chat-send').disabled=true;addMessage('user','📎 '+file.name);const typing=addMessage('bot','Читаю файл и ищу совпадения в каталоге…');typing.classList.add('typing');try{const data=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result.split(',')[1]);r.onerror=reject;r.readAsDataURL(file)});const result=await api('/api/attachments','POST',{name:file.name,type:file.type,data});typing.remove();renderReply(result)}catch(e){typing.remove();addMessage('bot',e.message||'Не удалось прочитать файл. Попробуйте другой формат.')}finally{state.chatBusy=false;$('#chat-send').disabled=false;$('#attachment').value=''}}
function showInfo(title,html){$('#info-content').innerHTML=`<span class="section-kicker">ЭЛЕКТРОКОМПЛЕКТ</span><h2>${esc(title)}</h2>${html}`;showDialog('#info-dialog')}
function policy(){const p=window.EKT_BOOTSTRAP?.policies;showInfo('Доставка и оплата',`<p>Условия зависят от города, товара и состава заказа. Хелпи поможет разобраться в подтверждённых условиях; окончательные стоимость и срок доставки уточняются при оформлении.</p><p><a href="https://ekt.kz/checkout-delivery/" target="_blank" rel="noopener">Актуальные условия на ekt.kz ↗</a></p><button class="button primary" data-policy-chat>Задать вопрос Хелпи ${icon('arrow')}</button>`)}
function downloadCart(){const lines=['ЭЛЕКТРОКОМПЛЕКТ — СПИСОК ДЛЯ ЗАКАЗА','Дата: '+new Date().toLocaleString('ru-RU'),'Это список подбора, не оформленный заказ.','Цены и остатки требуют проверки перед покупкой.','',...state.cart.items.map(({product:p,quantity:q},i)=>`${i+1}. ${p.name}\nАртикул: ${p.sku}\nКоличество: ${q} ${p.unit||'шт'}; цена: ${money(p.price)}; сумма: ${money(p.price==null?null:p.price*q)}\n`),'Итого по известным ценам: '+money(state.cart.total),'','Контакты: https://ekt.kz/about/contacts/'];const blob=new Blob(['\ufeff'+lines.join('\n')],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='EKT-spisok-zakaza.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);toast('Список заказа скачан')}
document.addEventListener('click',async e=>{const b=e.target.closest('button,a');if(!b)return;const ds=b.dataset;
if('catalog'in ds){e.preventDefault();goCatalog('')}
else if('query'in ds)goCatalog(ds.query);
else if('chat'in ds)openChat();
else if('prompt'in ds)openChat(ds.prompt);
else if('favorite'in ds)toggleFavorite(ds.favorite);
else if('detail'in ds||'quickAdd'in ds)openDetail(ds.detail||ds.quickAdd);
else if('closeDialog'in ds)b.closest('dialog').close();
else if('retry'in ds)loadProducts();
else if('askProduct'in ds){$('#product-dialog').close();openChat('Расскажи о товаре '+ds.askProduct+', его наличии и характеристиках')}
else if('propose'in ds){const p=state.products.get(ds.propose);openChat('Добавь '+(p?.minimumQuantity||1)+' '+(p?.unit||'шт')+' товара '+ds.propose)}
else if('confirm'in ds)confirmProposal(b);
else if('openCart'in ds)openCart();
else if('policy'in ds)policy();
else if('policyChat'in ds){$('#info-dialog').close();openChat('Какие условия доставки и оплаты?')}
else if('cartCatalog'in ds){$('#cart-dialog').close();goCatalog('')}
else if('cartChat'in ds){$('#cart-dialog').close();openChat('Помоги разобраться с оформлением заказа')}
else if('step'in ds){const input=$('#detail-quantity');const step=Number(input.step)||1;input.value=Math.max(Number(input.min)||1,Math.min(Number(input.max)||100000,Number(input.value)+Number(ds.step)*step))}
else if('cartQty'in ds||'remove'in ds){b.disabled=true;try{const id=ds.cartQty||ds.remove,qty=Number(ds.qty);updateCart(await api('/api/cart',ds.remove||qty<1?'DELETE':'PATCH',{productId:id,quantity:qty,confirm:true}))}catch(err){toast(err.message,true);b.disabled=false}}
else if('city'in ds){state.city=ds.city;$('#current-city').textContent=ds.city;$('#info-dialog').close();toast('Город: '+ds.city+'. Остатки доступны в карточках товаров.')}
else if(b.id==='detail-add')addCurrent();else if(b.id==='download-cart')downloadCart();
});

варах могут передаваться провайдеру ИИ; изображения отправляются только при включённом распознавании фото.</p><p>В автономном предпросмотре сообщения обрабатываются в вашем браузере. Избранное сохраняется на этом устройстве.</p>');$('#refresh-catalog').onclick=async()=>{try{state.status=await api('/api/status');updateStatus();loadProducts()}catch(e){toast(e.message,true)}};$$('dialog').forEach(d=>d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()}}));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('dialog[open]')&&!$('#chat-panel').hidden)closeChat()});
async function init(){updateFavorites();$('#year').textContent=new Date().getFullYear();if(!state.preview){try{const r=await fetch('/api/status',{signal:AbortSignal.timeout(5000),credentials:'same-origin'});if(!r.ok)throw Error();state.status=await r.json()}catch{state.preview=true}}if(state.preview){try{state.status=await api('/api/status')}catch{state.status={mode:'offline'}}}updateStatus();await Promise.allSettled([loadProducts(),api('/api/cart').then(updateCart)]);if(location.pathname==='/cart'||location.hash==='#cart')openCart();if(location.pathname.startsWith('/product/'))openDetail(decodeURIComponent(location.pathname.split('/').pop()));if(!state.preview)setInterval(async()=>{try{state.status=await api('/api/status');updateStatus()}catch{}},60000)}
